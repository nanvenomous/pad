{
  "name": "app",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "tw": "bun run tailwindcss -i web/input.css -o ./build/css/tailwind-generated.min.css",
    "js": "bun build web/index.ts --outdir ./build --minify && bun build web/service-worker.ts --outdir ./build --minify",
    "test": "bun test web/*.test.ts",
    "test:watch": "bun test --watch web/*.test.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "@types/markdown-it": "^14.1.2",
    "@types/bun": "latest",
    "daisyui": "^5.3.2",
    "tailwindcss": "^4.1.14"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "htmx-ext-ws": "^2.0.4",
    "htmx.org": "^2.0.8",
    "markdown-it": "^14.1.0"
  }
}
