package ui

import (
	"fmt"
	gonanoid "github.com/matoous/go-nanoid/v2"
	"math/rand"
)

var (
	logo = "./assets/package.svg"
)

func NanoID() string {
	id, err := gonanoid.New()
	if err != nil {
		min, max := 1, 9999999
		return fmt.Sprintf("%d", rand.Intn(max-min+1)+min)
	}
	return id
}

// Multi sends multiple templ components one after the other
// extra useful for htmx out of band swaps
templ Multi(chn ...templ.Component) {
	for _, chd := range chn {
		@chd
	}
}

type headerLink struct {
	Rel, Href string
}

var (
	headerLinks = []headerLink{
		{Rel: "manifest", Href: "/manifest.json"},
		{Rel: "icon", Href: logo},
		{Rel: "apple-touch-icon", Href: logo},
		{Rel: "stylesheet", Href: "/icons/light/style.css"},
		{Rel: "stylesheet", Href: "/css/tailwind-generated.min.css"},
	}
)

templ headers() {
	<meta charset="utf-8"/>
	<meta name="description" content="Self-hosted markdown notes with fast conflict-aware sync."/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	for _, lk := range headerLinks {
		<link rel={ lk.Rel } href={ lk.Href }/>
	}
	<script src="/index.js"></script>
	@templ.JSFuncCall("applySavedTheme")
	<title>Pad</title>
}

type PropsEmptyModalPopover struct {
	SwapOOB bool
}

templ EmptyModalPopover(props PropsEmptyModalPopover) {
	<dialog
		id="modal"
		class="absolute top-0 w-full z-30 pointer-events-none"
		if props.SwapOOB {
			hx-swap-oob="outerHTML:#modal"
		}
	></dialog>
}

templ popovers() {
	<div
		id="toastContainer"
		class="fixed top-0 left-0 right-0 flex flex-col justify-start items-center z-50 pointer-events-none"
	></div>
	@ActionsMenuPopover()
	<div class="fixed top-0 left-0 right-0 z-40 pointer-events-none">
		@progress()
	</div>
	@EmptyModalPopover(PropsEmptyModalPopover{})
}

templ ActionsMenuPopover() {
	<details id="actionsMenu" class="dropdown fixed z-50 hidden">
		<summary class="h-0 w-0 overflow-hidden p-0 m-0 pointer-events-none opacity-0">
			Actions
		</summary>
		<ul class="menu dropdown-content z-[1] w-56 rounded-2xl border border-base-200/70 bg-base-100/95 p-2 shadow-lg backdrop-blur text-sm">
			<li class="menu-title text-xs uppercase tracking-[0.2em] text-base-content/50">
				<span data-actions-title></span>
			</li>
			<li>
				<button
					type="button"
					class="justify-start"
					data-actions-move
					data-actions-close
					hx-target="#modal"
					hx-swap="outerHTML"
				>
					@icon("", "ph-folder text-base")
					Move
				</button>
			</li>
			<li>
				<form
					data-actions-delete-form
					data-actions-close
					hx-post="/notes/delete"
					hx-target="#notesMain"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="id" data-actions-id/>
					<input type="hidden" name="revision" data-actions-revision/>
					<button class="text-error justify-start" type="submit">
						@icon("", "ph-trash text-base")
						Delete
					</button>
				</form>
			</li>
		</ul>
	</details>
}

templ Page() {
	<head>
		@headers()
	</head>
	<body class="absolute top-0 bottom-0 left-0 right-0 bg-base-100 font-pad bg-[radial-gradient(circle_at_15%_10%,rgba(56,189,248,0.18),transparent_45%),radial-gradient(circle_at_85%_20%,rgba(249,115,22,0.15),transparent_45%),radial-gradient(circle_at_20%_80%,rgba(52,211,153,0.12),transparent_50%),linear-gradient(135deg,rgba(248,250,252,0.95),rgba(226,232,240,0.92))] dark:bg-[radial-gradient(circle_at_20%_20%,rgba(14,165,233,0.18),transparent_45%),radial-gradient(circle_at_80%_15%,rgba(59,130,246,0.18),transparent_45%),radial-gradient(circle_at_70%_80%,rgba(16,185,129,0.15),transparent_50%),linear-gradient(135deg,rgba(10,15,26,0.98),rgba(2,6,23,0.98))]">
		@popovers()
		<div id={ "appContent" } class="w-full h-full">
			{ children... }
		</div>
	</body>
}

templ icon(id, css string) {
	<i
		if id != "" {
			id={ id }
		}
		class={ "ph-light", css }
	></i>
}
