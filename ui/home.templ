package ui

import (
	"fmt"
	"net/url"
	"strconv"
)

type NoteListItem struct {
	ID           string
	Title        string
	UpdatedLabel string
	UpdatedAt    string
	Selected     bool
	Folder       string
	Revision     int
}

type NoteEditor struct {
	ID           string
	Title        string
	Body         string
	Revision     int
	UpdatedLabel string
	UpdatedAt    string
	Folder       string
}

type NoteFolder struct {
	Name     string
	Path     string
	Open     bool
	Notes    []NoteListItem
	Children []NoteFolder
	Count    int
}

type PropsNotesMain struct {
	Folders       []NoteFolder
	Items         []NoteListItem
	Editor        NoteEditor
	HasSelection  bool
	ForceNew      bool
	NotesCount    int
	CurrentFolder string
}

templ NotesPage(props PropsNotesMain) {
	@Page() {
		<div class="flex h-full w-full flex-col gap-3 overflow-hidden px-3 pb-4 pt-4 sm:px-4 lg:px-6">
			<div class="mx-auto hidden w-full max-w-6xl flex-wrap items-center justify-between gap-3 lg:flex">
				<div class="flex items-center gap-3">
					<div class="h-9 w-9 rounded-xl bg-accent/20 p-2 text-accent">
						@icon("", "ph-notebook text-xl")
					</div>
					<h1 class="text-2xl font-bold tracking-tight">Pad</h1>
				</div>
			</div>
			<div class="mx-auto w-full max-w-6xl flex-1 overflow-hidden">
				@NotesMain(props, false)
			</div>
		</div>
	}
}

templ NotesSidebar(props PropsNotesMain, swapOOB bool) {
	<aside
		id="notesSidebar"
		class="flex h-full w-72 flex-col overflow-hidden rounded-2xl border border-base-200/70 bg-base-100/95 p-3 shadow-sm sm:w-80 lg:w-72"
		if swapOOB {
			hx-swap-oob="true"
		}
	>
		<div class="flex items-center justify-between gap-2">
			<div class="flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-base-content/60">
				@icon("", "ph-stack text-lg")
				<span>Notes</span>
				<span class="rounded-full bg-base-200 px-2 py-0.5 text-[10px]">
					{ fmt.Sprintf("%d", props.NotesCount) }
				</span>
			</div>
			<button
				class="btn btn-xs rounded-full bg-accent text-accent-content hover:bg-accent/90"
				hx-get={ "/notes/new?folder=" + url.QueryEscape(props.CurrentFolder) }
				hx-target="#notesMain"
				hx-swap="outerHTML"
				hx-push-url="/"
			>
				@icon("", "ph-plus-circle text-base")
				New
			</button>
		</div>
		<div class="mt-3 flex-1 overflow-y-auto pr-1">
			if len(props.Items) == 0 {
				<div class="rounded-xl border border-dashed border-base-300/80 bg-base-200/40 p-4 text-xs text-base-content/70">
					No notes yet. Start a new markdown page to sync.
				</div>
			}
			for _, folder := range props.Folders {
				@NotesFolder(folder)
			}
		</div>
		<div class="mt-auto flex items-center justify-between gap-2 border-t border-base-200/60 pt-3">
			<a class="btn btn-ghost btn-xs rounded-full" href="/theme">
				@icon("", "ph-gear text-sm")
				Settings
			</a>
		</div>
	</aside>
}

templ NotesFolder(folder NoteFolder) {
	<details
		class="mb-2 rounded-xl border border-base-200/60 bg-base-100/70 px-3 py-2 text-sm"
		if folder.Open {
			open
		}
	>
		<summary class="flex cursor-pointer list-none items-center justify-between gap-2 text-xs uppercase tracking-[0.2em] text-base-content/60">
			<span class="flex items-center gap-2">
				@icon("", "ph-folder text-base")
				{ folder.Name }
			</span>
			<span class="rounded-full bg-base-200 px-2 py-0.5 text-[10px]">
				{ fmt.Sprintf("%d", folder.Count) }
			</span>
		</summary>
		<div class="mt-2 space-y-2">
			for _, item := range folder.Notes {
				<button
					class={
						"w-full select-none touch-manipulation rounded-xl border border-base-200/60 bg-base-100/70 px-3 py-2.5 text-left text-sm transition",
						templ.KV("border-accent/80 bg-accent/15 shadow-lg ring-2 ring-accent/30", item.Selected),
						templ.KV("hover:border-accent/50", !item.Selected),
					}
					if item.Selected {
						aria-current="page"
					}
					data-note-item
					data-note-id={ item.ID }
					data-note-title={ item.Title }
					data-note-revision={ fmt.Sprintf("%d", item.Revision) }
					hx-get={ "/notes/select?id=" + url.QueryEscape(item.ID) }
					hx-target="#notesMain"
					hx-swap="outerHTML"
					hx-push-url={ "/?id=" + url.QueryEscape(item.ID) }
				>
					<div class="flex items-start justify-between gap-2">
						<div class="font-semibold leading-tight">{ item.Title }</div>
						<div
							class="text-[10px] uppercase tracking-[0.2em] text-base-content/50"
							data-updated-at={ item.UpdatedAt }
						>
							{ item.UpdatedLabel }
						</div>
					</div>
				</button>
			}
			for _, child := range folder.Children {
				@NotesFolder(child)
			}
		</div>
	</details>
}

templ NotesEditorHeader(props PropsNotesMain, swapOOB bool) {
	<div
		id="editorHeader"
		class="flex flex-wrap items-center justify-between gap-3"
		if swapOOB {
			hx-swap-oob="true"
		}
	>
		<div>
			<h2 class="text-base font-semibold">
				if props.HasSelection {
					{ props.Editor.Title }
				} else {
					New note
				}
			</h2>
			<p class="text-[11px] uppercase tracking-[0.2em] text-base-content/50">
				if props.HasSelection {
					Updated <span data-updated-at={ props.Editor.UpdatedAt }>{ props.Editor.UpdatedLabel }</span>
				} else {
					Starts with a # heading for the title
				}
			</p>
		</div>
		<div class="flex items-center gap-2">
			<div
				id="saveStatus"
				class="badge badge-ghost gap-2 text-[10px] uppercase tracking-[0.2em] text-base-content/60"
			>
				<span class="ShowOnRequest flex items-center gap-1">
					<span class="loading loading-spinner loading-xs"></span>
					Saving
				</span>
				<span class="HideOnRequest flex items-center gap-1">
					@icon("", "ph-check-circle text-sm")
					Saved
				</span>
			</div>
			<button
				class="btn btn-ghost btn-xs rounded-full"
				data-note-actions
				data-note-id={ props.Editor.ID }
				if !props.HasSelection {
					disabled
				}
			>
				@icon("", "ph-dots-three-vertical text-sm")
			</button>
		</div>
	</div>
}

templ NotesEditorMeta(props PropsNotesMain, swapOOB bool) {
	<div
		id="notesMeta"
		class="hidden"
		if swapOOB {
			hx-swap-oob="outerHTML"
		}
	>
		<input
			id="noteId"
			type="hidden"
			name="id"
			value={ props.Editor.ID }
		/>
		<input
			id="noteRevision"
			type="hidden"
			name="revision"
			value={ fmt.Sprintf("%d", props.Editor.Revision) }
		/>
		<input
			id="noteFolder"
			type="hidden"
			name="folder"
			value={ props.CurrentFolder }
		/>
	</div>
}

templ NotesMain(props PropsNotesMain, swapOOB bool) {
	<section
		id="notesMain"
		class="w-full"
		if swapOOB {
			hx-swap-oob="true"
		}
	>
		@NotesStream(props, false)
		<div class="drawer h-full lg:drawer-open">
			<input id="notesDrawer" type="checkbox" class="drawer-toggle"/>
			<div class="drawer-content flex h-full w-full flex-col gap-3 overflow-hidden">
				<div class="flex items-center justify-between gap-2 lg:hidden">
					<label for="notesDrawer" class="btn btn-sm h-auto gap-3 rounded-full px-3 btn-ghost">
						<span class="flex h-8 w-8 items-center justify-center rounded-xl bg-accent/20 text-accent">
							@icon("", "ph-notebook text-base")
						</span>
						<span class="text-sm font-semibold tracking-tight">Pad</span>
					</label>
				</div>
				<section class="flex min-h-0 w-full flex-1 flex-col overflow-hidden rounded-2xl border border-base-200/70 bg-base-100/90 p-4 shadow-lg">
					@NotesEditorHeader(props, false)
					<form
						class="mt-4 flex min-h-0 w-full flex-1 flex-col gap-3"
						hx-post="/notes/save"
						hx-swap="none"
						hx-trigger="input changed delay:700ms from:textarea"
						hx-sync="this:replace"
						hx-indicator="#saveStatus"
					>
						@NotesEditorMeta(props, false)
						<div class="form-control flex min-h-0 w-full flex-1">
							<div data-note-editor class="flex min-h-0 w-full flex-1 flex-col">
								<div
									id="noteRender"
									data-note-render
									class="note-render hidden min-h-0 w-full flex-1 overflow-y-auto rounded-2xl bg-base-200/50 p-3 text-sm leading-6"
								></div>
								<textarea
									id="noteBody"
									name="body"
									data-note-body
									class="textarea textarea-bordered min-h-0 w-full flex-1 overflow-y-auto rounded-2xl bg-base-200/50 text-sm leading-6 focus:border-accent focus:outline-none"
									placeholder="# New idea&#10;&#10;Write in markdown. Sync resolves conflicts at the server."
								>{ props.Editor.Body }</textarea>
							</div>
						</div>
					</form>
				</section>
			</div>
			<div class="drawer-side h-full">
				<label for="notesDrawer" class="drawer-overlay"></label>
				<div class="h-full p-2 sm:p-3 lg:p-0">
					@NotesSidebar(props, false)
				</div>
			</div>
		</div>
	</section>
}

templ NotesStream(props PropsNotesMain, swapOOB bool) {
	<div
		id="notesStream"
		class="hidden"
		hx-ext="ws"
		ws-connect={ "/notes/stream?id=" + url.QueryEscape(props.Editor.ID) + "&new=" + strconv.FormatBool(props.ForceNew) }
		if swapOOB {
			hx-swap-oob="outerHTML"
		}
	></div>
}

templ NotesAutosaveResponse(props PropsNotesMain) {
	@NotesSidebar(props, true)
	@NotesEditorHeader(props, true)
	@NotesEditorMeta(props, true)
	@NotesStream(props, true)
}
